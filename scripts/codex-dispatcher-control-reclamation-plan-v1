#!/bin/sh

set -eu
umask 077

case "$#:$1" in
    1:auto-plan)
        ;;
    2:plan)
        [ "$2" = --write-plan ] || exit 2
        ;;
    3:recheck)
        [ "$2" = --plan-sha256 ] || exit 2
        ;;
    4:apply)
        [ "$2" = --plan-sha256 ] && [ "$4" = --apply ] || exit 2
        ;;
    8:bundle-confirm)
        [ "$2" = --bundle-id ] && [ "$4" = --manifest-sha256 ] && \
            [ "$6" = --off-host-copy-id ] && [ "$8" = --apply ] || exit 2
        ;;
    *)
        printf '%s\n' 'codex-dispatcher-control-reclamation-plan-v1: invalid command shape' >&2
        exit 2
        ;;
esac

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    printf '%s\n' 'codex-dispatcher-control-reclamation-plan-v1: root is required' >&2
    exit 2
fi

export HOME=/var/lib/codex-dispatcher/home
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PATH=/opt/codex-python/current/bin:/usr/bin:/bin
export PYTHONDONTWRITEBYTECODE=1
export PYTHONNOUSERSITE=1
export PYTHONPATH=/opt/codex-dispatcher/current/src

exec /opt/codex-python/current/bin/python3 -P -s -m \
    codex_dispatcher.control_host_reclamation "$@"
