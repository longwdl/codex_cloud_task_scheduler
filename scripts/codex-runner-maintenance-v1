#!/bin/sh

set -eu
umask 077

if [ "$(/usr/bin/id -u)" -ne 0 ]; then
    printf '%s\n' 'codex-runner-maintenance-v1: root is required' >&2
    exit 1
fi

case "$#:$1" in
    1:reclamation-auto-plan)
        ;;
    2:reclamation-plan)
        [ "$2" = --write-plan ] || exit 2
        ;;
    3:recovery-snapshot)
        [ "$2" = --current-release-commit ] || exit 2
        ;;
    3:reclamation-recheck)
        [ "$2" = --plan-sha256 ] || exit 2
        ;;
    4:reclamation-apply)
        [ "$2" = --plan-sha256 ] && [ "$4" = --apply ] || exit 2
        ;;
    *)
        printf '%s\n' 'codex-runner-maintenance-v1: invalid command shape' >&2
        exit 2
        ;;
esac

exec /usr/bin/env -i \
    HOME=/root \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/srv/codex-runner/current/src \
    /usr/bin/python3 -P -s -m codex_dispatcher.runner_maintenance "$@"
