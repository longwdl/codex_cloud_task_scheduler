#!/bin/sh

# Transactional two-host release activation for the reviewed Control/Runner layout.
# Run this on the Linux Control Host as the administrator account.  It deliberately
# stops before the first write-enabled Dispatcher sweep.

set -eu
umask 077

usage() {
    printf '%s\n' \
        'usage: codex-dispatcher-release-v1 --archive PATH --commit SHA --sha256 SHA256 --apply' >&2
    exit 2
}

if [ "$#" -ne 7 ] || [ "$1" != "--archive" ] || [ "$3" != "--commit" ] || \
    [ "$5" != "--sha256" ] || [ "$7" != "--apply" ]; then
    usage
fi

archive=$2
commit=$4
expected_archive_sha256=$6

case "$commit" in
    *[!0-9a-f]*|'') usage ;;
esac
[ "${#commit}" -eq 40 ] || usage
case "$expected_archive_sha256" in
    *[!0-9a-f]*|'') usage ;;
esac
[ "${#expected_archive_sha256}" -eq 64 ] || usage
case "$archive" in
    /var/tmp/codex-dispatcher-release-"$commit".tar) ;;
    *) printf '%s\n' 'release archive must use the exact protected /var/tmp path' >&2; exit 2 ;;
esac

[ -f "$archive" ] && [ ! -L "$archive" ] || {
    printf '%s\n' 'release archive is unavailable or is a symlink' >&2
    exit 1
}
[ "$(id -u)" -ne 0 ] || {
    printf '%s\n' 'run as the administrator account, not root' >&2
    exit 1
}
/usr/bin/sudo -n true
/usr/bin/ssh -o BatchMode=yes codex-runner /usr/bin/sudo -n true

actual_archive_sha256=$(/usr/bin/sha256sum "$archive" | /usr/bin/cut -d ' ' -f 1)
[ "$actual_archive_sha256" = "$expected_archive_sha256" ] || {
    printf '%s\n' 'release archive SHA-256 mismatch' >&2
    exit 1
}

# Reject links, devices, absolute members, traversal, and duplicate names before
# either root account extracts the reviewed Git archive.
/usr/bin/python3 -c '
import pathlib, sys, tarfile
p = pathlib.Path(sys.argv[1])
seen = set()
with tarfile.open(p, "r:") as archive:
    members = archive.getmembers()
    if not members:
        raise SystemExit("release archive is empty")
    for member in members:
        parts = pathlib.PurePosixPath(member.name).parts
        if (not member.name or member.name.startswith("/") or ".." in parts
                or member.name in seen or not (member.isdir() or member.isfile())):
            raise SystemExit("release archive contains an unsafe member")
        seen.add(member.name)
' "$archive"

control_release=/opt/codex-dispatcher/releases/$commit
runner_release=/srv/codex-runner/releases/$commit
short_commit=$(/usr/bin/printf '%s' "$commit" | /usr/bin/cut -c 1-12)
control_validation=/var/lib/codex-dispatcher/release-validation-$short_commit
runner_validation=/srv/codex-runner/run/release-validation-$short_commit
runner_archive=/var/tmp/codex-dispatcher-release-$commit.tar

previous_control=$(/usr/bin/readlink /opt/codex-dispatcher/current)
previous_runner=$(/usr/bin/ssh -o BatchMode=yes codex-runner /usr/bin/readlink /srv/codex-runner/current)
case "$previous_control" in /opt/codex-dispatcher/releases/[0-9a-f]*) ;;
    *) printf '%s\n' 'current Control release link is unsafe' >&2; exit 1 ;;
esac
case "$previous_runner" in releases/[0-9a-f]*|/srv/codex-runner/releases/[0-9a-f]*) ;;
    *) printf '%s\n' 'current Runner release link is unsafe' >&2; exit 1 ;;
esac
case "$previous_runner" in
    /*) previous_runner_release=$previous_runner ;;
    *) previous_runner_release=/srv/codex-runner/$previous_runner ;;
esac

control_units='codex-dispatcher.service codex-dispatcher.timer codex-dispatcher-backup.service codex-dispatcher-backup.timer codex-dispatcher-health.service codex-dispatcher-health.timer codex-dispatcher-restore-drill.service codex-dispatcher-restore-drill.timer'

switched=0
cleanup() {
    status=$?
    if [ "$status" -ne 0 ] && [ "$switched" -eq 1 ]; then
        # No Dispatcher sweep has been started by this tool.  It is therefore
        # safe to restore both code/unit views, Control first to prevent a new
        # client from reaching the candidate Runner, then Runner.
        /usr/bin/sudo -n /usr/bin/ln -sfn "$previous_control" /opt/codex-dispatcher/current.rollback
        /usr/bin/sudo -n /usr/bin/mv -Tf /opt/codex-dispatcher/current.rollback /opt/codex-dispatcher/current
        /usr/bin/ssh -o BatchMode=yes codex-runner \
            "/usr/bin/sudo -n /usr/bin/ln -sfn '$previous_runner' /srv/codex-runner/current.rollback && /usr/bin/sudo -n /usr/bin/mv -Tf /srv/codex-runner/current.rollback /srv/codex-runner/current" || true
        for unit in $control_units; do
            /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 \
                "$previous_control/deploy/systemd/$unit" "/etc/systemd/system/$unit" || true
        done
        /usr/bin/ssh -o BatchMode=yes codex-runner \
            "/usr/bin/sudo -n /usr/bin/install -o root -g root -m 0755 '$previous_runner_release/scripts/codex-runner-v1' /srv/codex-runner/bin/codex-runner-v1 && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0755 '$previous_runner_release/scripts/codex-runner-capacity-v1' /srv/codex-runner/bin/codex-runner-capacity-v1 && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 '$previous_runner_release/deploy/runner/codex-runner-capacity.service' /etc/systemd/system/codex-runner-capacity.service && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 '$previous_runner_release/deploy/runner/codex-runner-capacity.timer' /etc/systemd/system/codex-runner-capacity.timer" || true
        /usr/bin/sudo -n /usr/bin/systemctl daemon-reload || true
        /usr/bin/ssh -o BatchMode=yes codex-runner /usr/bin/sudo -n /usr/bin/systemctl daemon-reload || true
    fi
    /usr/bin/sudo -n /usr/bin/find "$control_validation" -xdev -depth -delete 2>/dev/null || true
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        "/usr/bin/sudo -n /usr/bin/find '$runner_validation' -xdev -depth -delete 2>/dev/null || true; /usr/bin/rm -f '$runner_archive'" || true
    if [ "$status" -ne 0 ]; then
        /usr/bin/sudo -n /usr/bin/find "$control_release" -xdev -depth -delete 2>/dev/null || true
        /usr/bin/ssh -o BatchMode=yes codex-runner \
            "/usr/bin/sudo -n /usr/bin/find '$runner_release' -xdev -depth -delete 2>/dev/null || true" || true
    fi
    /usr/bin/rm -f "$archive"
    exit "$status"
}
trap cleanup EXIT HUP INT TERM

# A verified Online Backup precedes any timer stop or release mutation.
/usr/bin/sudo -n /usr/bin/systemctl start codex-dispatcher-backup.service
[ "$(/usr/bin/sudo -n /usr/bin/systemctl show codex-dispatcher-backup.service -p Result --value)" = success ]

for timer in \
    codex-dispatcher.timer \
    codex-dispatcher-health.timer \
    codex-dispatcher-backup.timer \
    codex-dispatcher-restore-drill.timer
do
    /usr/bin/sudo -n /usr/bin/systemctl stop "$timer"
done
for service in \
    codex-dispatcher.service \
    codex-dispatcher-health.service \
    codex-dispatcher-backup.service \
    codex-dispatcher-restore-drill.service
do
    [ "$(/usr/bin/systemctl is-active "$service" || true)" = inactive ]
done
# RuntimeDirectory is ephemeral and may disappear when the oneshot Dispatcher
# exits. Recreate the exact systemd-owned boundary before checking the lock;
# never let flock create a root-owned lock file.
/usr/bin/sudo -n /usr/bin/install -d \
    -o codex-dispatcher -g codex-dispatcher -m 0700 /run/codex-dispatcher
/usr/bin/sudo -n -u codex-dispatcher /usr/bin/flock -n /run/codex-dispatcher/dispatcher.lock /usr/bin/true
/usr/bin/ssh -o BatchMode=yes codex-runner \
    /usr/bin/sudo -n -u codex-runner /usr/bin/flock -n /srv/codex-runner/run/active.lock /usr/bin/true

stage_control() {
    [ ! -e "$control_release" ] || {
        printf '%s\n' 'candidate Control release already exists' >&2
        return 1
    }
    /usr/bin/sudo -n /usr/bin/install -d -o root -g root -m 0755 "$control_release"
    /usr/bin/sudo -n /usr/bin/tar --extract --file "$archive" --directory "$control_release" --no-same-owner
    /usr/bin/sudo -n /usr/bin/chown -R root:root "$control_release"
    /usr/bin/sudo -n /usr/bin/chmod -R go-w "$control_release"
}

stage_runner() {
    /usr/bin/ssh -o BatchMode=yes codex-runner "/usr/bin/test ! -e '$runner_release'"
    /usr/bin/ssh -o BatchMode=yes codex-runner "umask 077; /usr/bin/tee '$runner_archive' >/dev/null" < "$archive"
    observed=$(/usr/bin/ssh -o BatchMode=yes codex-runner "/usr/bin/sha256sum '$runner_archive' | /usr/bin/cut -d ' ' -f 1")
    [ "$observed" = "$expected_archive_sha256" ]
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        "/usr/bin/sudo -n /usr/bin/install -d -o root -g root -m 0755 '$runner_release' && /usr/bin/sudo -n /usr/bin/tar --extract --file '$runner_archive' --directory '$runner_release' --no-same-owner && /usr/bin/sudo -n /usr/bin/chown -R root:root '$runner_release' && /usr/bin/sudo -n /usr/bin/chmod -R go-w '$runner_release'"
}

validate_control() {
    /usr/bin/sudo -n /usr/bin/install -d -o codex-dispatcher -g codex-dispatcher -m 0700 "$control_validation"
    /usr/bin/sudo -n /usr/bin/cp -a "$control_release"/. "$control_validation"/
    /usr/bin/sudo -n /usr/bin/chown -R codex-dispatcher:codex-dispatcher "$control_validation"
    /usr/bin/sudo -n -u codex-dispatcher /bin/sh -c \
        'set -eu; umask 077; cd "$1"; PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src:. /opt/codex-python/current/bin/python3 -P -s -m unittest discover -s tests -q; PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src:. /opt/codex-python/current/bin/python3 -P -s -m compileall -q src tests; /bin/sh -n scripts/codex-dispatcher-v1 scripts/codex-dispatcher-health-v1 scripts/codex-dispatcher-backup-v1 scripts/codex-dispatcher-restore-drill-v1' \
        release-validation "$control_validation"
}

validate_runner() {
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        "/usr/bin/sudo -n /usr/bin/install -d -o codex-runner -g codex-runner -m 0700 '$runner_validation' && /usr/bin/sudo -n /usr/bin/cp -a '$runner_release'/.' '$runner_validation'/ && /usr/bin/sudo -n /usr/bin/chown -R codex-runner:codex-runner '$runner_validation'"
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        /usr/bin/sudo -n -u codex-runner /usr/bin/env -i \
        HOME=/srv/codex-runner/home LANG=C.UTF-8 LC_ALL=C.UTF-8 \
        PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
        "PYTHONPATH=$runner_validation/src:$runner_validation" \
        /usr/bin/python3 -P -s -m unittest discover \
        -s "$runner_validation/tests" -q
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        /usr/bin/sudo -n -u codex-runner /usr/bin/env -i \
        HOME=/srv/codex-runner/home LANG=C.UTF-8 LC_ALL=C.UTF-8 \
        PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
        "PYTHONPATH=$runner_validation/src:$runner_validation" \
        /usr/bin/python3 -P -s -m compileall -q \
        "$runner_validation/src" "$runner_validation/tests"
    /usr/bin/ssh -o BatchMode=yes codex-runner \
        /bin/sh -n "$runner_validation/scripts/codex-runner-v1" \
        "$runner_validation/scripts/codex-runner-capacity-v1"
}

stage_control
stage_runner
validate_control
validate_runner

# Activate Runner first.  From this point every failure triggers the trap's
# pre-write two-host symlink rollback.
/usr/bin/ssh -o BatchMode=yes codex-runner \
    "/usr/bin/sudo -n /usr/bin/ln -sfn 'releases/$commit' /srv/codex-runner/current.next && /usr/bin/sudo -n /usr/bin/mv -Tf /srv/codex-runner/current.next /srv/codex-runner/current"
switched=1
/usr/bin/sudo -n /usr/bin/ln -sfn "$control_release" /opt/codex-dispatcher/current.next
/usr/bin/sudo -n /usr/bin/mv -Tf /opt/codex-dispatcher/current.next /opt/codex-dispatcher/current

for unit in $control_units; do
    /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 \
        "$control_release/deploy/systemd/$unit" "/etc/systemd/system/$unit"
done
/usr/bin/ssh -o BatchMode=yes codex-runner \
    "/usr/bin/sudo -n /usr/bin/install -o root -g root -m 0755 '$runner_release/scripts/codex-runner-v1' /srv/codex-runner/bin/codex-runner-v1 && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0755 '$runner_release/scripts/codex-runner-capacity-v1' /srv/codex-runner/bin/codex-runner-capacity-v1 && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 '$runner_release/deploy/runner/codex-runner-capacity.service' /etc/systemd/system/codex-runner-capacity.service && /usr/bin/sudo -n /usr/bin/install -o root -g root -m 0644 '$runner_release/deploy/runner/codex-runner-capacity.timer' /etc/systemd/system/codex-runner-capacity.timer"

/usr/bin/sudo -n /usr/bin/systemctl daemon-reload
/usr/bin/ssh -o BatchMode=yes codex-runner /usr/bin/sudo -n /usr/bin/systemctl daemon-reload
/usr/bin/sudo -n /usr/bin/systemd-analyze verify \
    /etc/systemd/system/codex-dispatcher.service \
    /etc/systemd/system/codex-dispatcher.timer \
    /etc/systemd/system/codex-dispatcher-backup.service \
    /etc/systemd/system/codex-dispatcher-backup.timer \
    /etc/systemd/system/codex-dispatcher-health.service \
    /etc/systemd/system/codex-dispatcher-health.timer \
    /etc/systemd/system/codex-dispatcher-restore-drill.service \
    /etc/systemd/system/codex-dispatcher-restore-drill.timer
/usr/bin/ssh -o BatchMode=yes codex-runner \
    /usr/bin/sudo -n /usr/bin/systemd-analyze verify \
    /etc/systemd/system/codex-runner-capacity.service \
    /etc/systemd/system/codex-runner-capacity.timer
/usr/bin/ssh -o BatchMode=yes codex-runner /usr/bin/sudo -n /usr/bin/systemctl start codex-runner-capacity.service

switched=0
/usr/bin/printf '{"ok":true,"release_commit":"%s","archive_sha256":"%s","previous_control":"%s","previous_runner":"%s","runner_first":true,"timers_started":false,"requires_manual_sweep":true}\n' \
    "$commit" "$expected_archive_sha256" "$previous_control" "$previous_runner"
