{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "needs_input", "tests", "changed_paths", "next_step"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_input", "blocked"],
      "description": "Use needs_input exactly when a human answer is required. Use blocked only for a safety or environment blocker that has no question for a human."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "needs_input": {
      "type": "array",
      "maxItems": 20,
      "description": "Must contain at least one question exactly when status is needs_input; must be empty for completed or blocked.",
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 500},
          "status": {"type": "string", "enum": ["passed", "failed", "not_run"]}
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 1000,
      "description": "Actual normalized repository-relative paths changed by this turn, with no duplicates. Use an empty array when no files changed.",
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
