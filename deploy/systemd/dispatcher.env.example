# Install as /etc/codex-dispatcher/dispatcher.env with owner root:root and mode 0600.
# This is a systemd EnvironmentFile, not a shell script: do not add "export".
CODEX_DISPATCHER_ENABLE_SSH_WRITES=1
GITHUB_TOKEN=replace-with-repository-scoped-token

# Enable both lines only when [slack_runtime] is present in config.toml and the
# outbound-only Slack App has completed the repository's idempotency fixture.
# CODEX_DISPATCHER_ENABLE_SLACK_WRITES=1
# SLACK_BOT_TOKEN=replace-with-outbound-only-bot-token
