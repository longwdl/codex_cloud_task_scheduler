[Unit]
Description=Codex dispatcher lifecycle health check and Slack alert projection
Documentation=file:///opt/codex-dispatcher/current/docs/implementation-deployment-test-plan.md
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/opt/codex-dispatcher/current/scripts/codex-dispatcher-health-v1
ConditionPathIsDirectory=/etc/codex-dispatcher
ConditionPathIsDirectory=/var/lib/codex-dispatcher

[Service]
Type=oneshot
User=codex-dispatcher
Group=codex-dispatcher
UMask=0077
WorkingDirectory=/var/lib/codex-dispatcher
EnvironmentFile=/etc/codex-dispatcher/health.env
ExecStart=/opt/codex-dispatcher/current/scripts/codex-dispatcher-health-v1

ReadWritePaths=/var/lib/codex-dispatcher

TimeoutStartSec=60s
TimeoutStopSec=10s
KillMode=control-group
SendSIGKILL=yes
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-dispatcher-health

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64
