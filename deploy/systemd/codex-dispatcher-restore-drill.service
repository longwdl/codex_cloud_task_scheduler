[Unit]
Description=Codex dispatcher protected SQLite restore drill
Documentation=file:///opt/codex-dispatcher/current/docs/implementation-deployment-test-plan.md
ConditionFileIsExecutable=/opt/codex-dispatcher/current/scripts/codex-dispatcher-restore-drill-v1
ConditionPathIsDirectory=/etc/codex-dispatcher
ConditionPathIsDirectory=/var/lib/codex-dispatcher/backups

[Service]
Type=oneshot
User=codex-dispatcher
Group=codex-dispatcher
UMask=0077
WorkingDirectory=/var/lib/codex-dispatcher
ExecStart=/opt/codex-dispatcher/current/scripts/codex-dispatcher-restore-drill-v1

ReadWritePaths=/var/lib/codex-dispatcher

TimeoutStartSec=5min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-dispatcher-restore-drill

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64
