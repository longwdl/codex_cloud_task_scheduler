# Host-specific production rules for the current s3 Runner.
# Revalidate both UIDs, public addresses, routes and the resolver before every install.

destroy table inet codex_egress
table inet codex_egress {
    set blocked_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            8.210.180.114/32,
            10.0.0.0/8,
            47.79.99.219/32,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.88.99.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    chain output {
        type filter hook output priority -10; policy accept;

        # Existing connections are admitted only after the guarded activation
        # proves that the Runner UID has no pre-existing outbound socket.
        ct state established,related accept

        # The Runner can create only one new connection: the local proxy.
        meta skuid 1002 ip daddr 127.0.0.1 tcp dport 3128 counter accept
        meta skuid 1002 counter reject

        # Squid can use only the systemd-resolved stub and public HTTPS.
        meta skuid 13 ip daddr 127.0.0.53 udp dport 53 counter accept
        meta skuid 13 ip daddr 127.0.0.53 tcp dport 53 counter accept
        meta skuid 13 ip daddr @blocked_ipv4 counter reject
        meta skuid 13 ip protocol tcp tcp dport 443 counter accept
        meta skuid 13 ip6 daddr 2000::/3 tcp dport 443 counter accept
        meta skuid 13 counter reject

        # A loopback source address is not an identity. No other local UID may
        # use the audited proxy, including an administrator without sudo.
        ip daddr 127.0.0.1 tcp dport 3128 meta skuid != 1002 counter reject
    }
}
