[Unit]
Description=Codex Runner read-only capacity admission check
Documentation=file:///srv/codex-runner/current/deploy/runner/README.md
ConditionFileIsExecutable=/srv/codex-runner/bin/codex-runner-capacity-v1
ConditionPathIsDirectory=/srv/codex-runner/work-items
ConditionPathIsDirectory=/srv/codex-runner/work-item-images

[Service]
Type=oneshot
User=codex-runner
Group=codex-runner
UMask=0077
WorkingDirectory=/srv/codex-runner
ExecStart=/srv/codex-runner/bin/codex-runner-capacity-v1

TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=control-group
SendSIGKILL=yes
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=codex-runner-capacity

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64
